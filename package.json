{
  "name": "koinos-ai",
  "productName": "Koinos AI",
  "version": "0.48.0",
  "private": true,
  "description": "Koinos AI Core — local-first AI with a self-hosted OpenAI-compatible API",
  "license": "MIT",
  "author": "therexdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/therexdev/kaiapp.git"
  },
  "workspaces": [
    "core"
  ],
  "scripts": {
    "core": "node core/server.js",
    "code": "node cli/koinos-code.js",
    "test": "node --test --test-concurrency=2 \"core/test/*.test.js\"",
    "start": "electron .",
    "dist": "electron-builder",
    "version:set": "node core/scripts/set-version.js"
  },
  "bin": {
    "koinos-code": "cli/koinos-code.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "io.koinosai.desktop",
    "productName": "Koinos AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "core/**",
      "ui/**",
      "cli/**",
      "!core/test/**",
      "package.json"
    ],
    "asarUnpack": [
      "cli/**",
      "ui/agents.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/bin",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "therexdev",
        "repo": "kaiapp",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^1.7.2",
    "electron-updater": "^6.8.9",
    "ethers": "^6.17.0",
    "imapflow": "^1.7.1",
    "koilib": "^9.3.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5"
  },
  "overrides": {
    "protobufjs": "7.4.0"
  }
}
