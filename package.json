{
  "name": "koinos-ai",
  "productName": "Koinos AI",
  "version": "0.23.2",
  "private": true,
  "description": "Koinos AI Core — local-first AI with a self-hosted OpenAI-compatible API",
  "license": "MIT",
  "author": "therexdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/therexdev/kaiapp.git"
  },
  "workspaces": [
    "core"
  ],
  "scripts": {
    "core": "node core/server.js",
    "test": "node --test \"core/test/*.test.js\"",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "io.koinosai.desktop",
    "productName": "Koinos AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "core/**",
      "ui/**",
      "!core/test/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "therexdev",
        "repo": "kaiapp",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koilib": "^9.3.0"
  },
  "overrides": {
    "protobufjs": "7.4.0"
  }
}
